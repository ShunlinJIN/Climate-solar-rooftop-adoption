#!/usr/bin/env bash
set -euo pipefail
CODE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SOLAR_VENV_DIR="${SOLAR_VENV_DIR:-/opt/climate-solar-venv}"
if [[ -x "$SOLAR_VENV_DIR/bin/python" ]]; then
  SOLAR_PYTHON="$SOLAR_VENV_DIR/bin/python"
elif [[ "$CODE_DIR" == /code ]]; then
  echo "The Python environment is missing. Build the capsule environment with environment/postInstall before running." >&2
  exit 1
else
  SOLAR_PYTHON="${SOLAR_PYTHON:-python3}"
fi
exec "$SOLAR_PYTHON" "$CODE_DIR/run_public.py" --data-dir "${SOLAR_DATA_DIR:-/data/non-confidential}" --output-dir "${SOLAR_OUTPUT_DIR:-/results}"
